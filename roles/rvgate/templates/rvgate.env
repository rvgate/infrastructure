# contact form backend (the `contact` service of rvgate.nl)
SMTP_HOST={{ rvgate.smtp.host }}
SMTP_PORT={{ rvgate.smtp.port | default(587) }}
SMTP_USER={{ rvgate.smtp.username }}
SMTP_PASSWORD={{ rvgate.smtp.password }}
MAIL_FROM={{ rvgate.mail_from | default('info@rvgate.nl') }}
MAIL_TO={{ rvgate.mail_to | default('info@rvgate.nl') }}
